# TMail API — copy this file to .env.local (dev) or set these on your host (production).
# These are read on the server only and are never sent to the browser.

# Base URL of the TMail server, without a trailing slash
TMAIL_BASE_URL=https://tmp.accinw.com

# Default domain used when the user types a name without "@domain"
TMAIL_DOMAIN=accinw.com

# API key configured in the TMail admin panel
TMAIL_API_KEY=

# Optional: request timeout in milliseconds (default 10000)
TMAIL_TIMEOUT_MS=10000

# Optional: log every upstream request, not just failures (default: on in dev, off in production)
TMAIL_DEBUG=
